{
  "name": "pr-lens",
  "productName": "PR Lens",
  "version": "0.1.1",
  "description": "Desktop side-by-side branch diff viewer with an AI PR review assistant",
  "homepage": "https://github.com/rmegi/pr-lens",
  "repository": {
    "type": "git",
    "url": "https://github.com/rmegi/pr-lens.git"
  },
  "main": "out/main/index.js",
  "author": {
    "name": "rmegi",
    "email": "rmegi@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@monaco-editor/react": "^4.7.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
